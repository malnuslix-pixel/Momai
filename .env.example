# ==============================================================================
# MWALIMU FAMILY - ENVIRONMENT VARIABLES TEMPLATE
# Copy these into your Vercel Project Settings -> Environment Variables
# And create your local .env.local file with your actual keys
# ==============================================================================

# 1. SUPABASE (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. CONTROL ROOM ADMIN ACCESS (Required)
ADMIN_SECRET_KEY=Mwalimu@2026!
NEXT_PUBLIC_ADMIN_SECRET_KEY=Mwalimu@2026!

# 3. PRODUCTION DOMAIN (Set this to your live domain or vercel.app URL)
NEXT_PUBLIC_APP_URL=https://mwalimufamily.co.ke

# 4. SAFARICOM M-PESA DARAJA API (Optional - defaults to sandbox/mock)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox

# 5. AI TUTOR KEYS (Optional - built-in Kenyan curriculum engine works without API keys)
